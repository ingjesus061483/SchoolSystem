@using ApiWebApplication.DTO
@model IEnumerable<MonthlyPaymentDTO>
@{
    CourseDTO course = (CourseDTO)TempData["course"];
    StudentDTO student = (StudentDTO)TempData["student"];
    ViewBag.Title = "Mensualides";
}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - @Utilities.app</title>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
</head>
<body>
    @if (course != null)
    {
        <div class="row" style="padding-top:50px">
            <div class="col-md-4">
            </div>
            <div class="col-md-4">
                <h1>
                    Curso
                </h1>
            </div>
            <div class="col-md-4">
            </div>
        </div>
        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-2">
                Nombre:
            </div>
            <div class="col-md-8">
                @course.Reference
            </div>
            <div class="col-md-1">
            </div>
        </div>
    }
    @if (student != null)
    {
        <div class="row" style="padding-top:50px">
            <div class="col-md-4">
            </div>
            <div class="col-md-4">
                <h1>
                    Estudiante
                </h1>
            </div>
            <div class="col-md-4">
            </div>
        </div>

        <div class="row" >
            <div class="col-md-1">
            </div>
            <div class="col-md-2">
                <strong>
                    Identificacion:
                </strong>
            </div>
            <div class="col-md-8">
                @student.Identification  
            </div>
            <div class="col-md-1">
            </div>
        </div>
        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-2">
                <strong>
                    Nombre completo:
                    </strong>
            </div>
            <div class="col-md-8">
                @student.CompleteName
            </div>
            <div class="col-md-1">
            </div>
        </div>

    }
    <div class="row" style="padding-top:50px">
        <div class="col-md-4">
        </div>
        <div class="col-md-4">
            <h1>
                Mensualidades
            </h1>
        </div>
        <div class="col-md-4">
        </div>
    </div>
    <div class="row" style="padding-top:50px">
        <div class="col-md-1">
        </div>
        <div class="col-md-10">
            <table id="table" class="table">
                <thead>
                    <tr>
                        <th>
                            Id
                        </th>
                        <th>
                            Codigo
                        </th>
                        <th>
                            Mensualidad
                        </th>
                        <th>
                            Valor a pagar
                        </th>
                        <th>
                            Detalle
                        </th>
                        <th>
                            Pago confirmado
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Id)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Code)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Monthly)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Value)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Detail)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Confirmed)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-md-1">
        </div>
    </div>
</body>
</html>


